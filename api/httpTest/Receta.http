### CREATE nueva Receta
POST {{baseUrl}}/recetas
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "id_cliente": 2,
    "doctor_remitente": "Ana Torres",
    "ruc_doctor_remitente": "1712345678001",
    "hospital_remitente": "Clinica Norte",
    "telefono_hospital": "022345678",
    "correo": "contacto@clinicanorte.com",
    "codigo": 1001,
    "fecha": "2026-04-14"
}

### READ una Receta
GET {{baseUrl}}/recetas/1
Authorization: Bearer {{accessToken}}

### READ todas las Recetas
GET {{baseUrl}}/recetas/all
Authorization: Bearer {{accessToken}}

### UPDATE una Receta
PUT {{baseUrl}}/recetas/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "id_cliente": 1,
    "doctor_remitente": "Ana Torres",
    "hospital_remitente": "Clinica Central",
    "telefono_hospital": "022000111",
    "codigo": 1002,
    "fecha": "2026-04-15"
}

### DELETE una Receta
DELETE {{baseUrl}}/recetas/1
Authorization: Bearer {{accessToken}}

### Casos específicos
POST {{baseUrl}}/recetas/dosis
Authorization: Bearer {{accessToken}}
Content-Type: application/json
{
  "Receta": {
    "id_cliente": 1,
    "doctor_remitente": "Dr. Juan Pérez",
    "ruc_doctor_remitente": "1234567890",
    "hospital_remitente": "Hospital Central",
    "telefono_hospital": "555-1234",
    "correo": "doctor@hospital.com",
    "codigo": 12345,
    "fecha": "2025-04-25T10:30:00Z"
  },
  "Dosis": [
    {
      "id_medicamento": 1,
      "cantidad": 2,
      "instrucciones": "Tomar cada 8 horas con comida"
    },
    {
      "id_medicamento": 2,
      "cantidad": 1,
      "instrucciones": "Tomar una vez al día por las noches"
    }
  ]
}
