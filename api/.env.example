# Variables de Entorno - Copia a .env y completa con tus valores reales
# NUNCA confirmes el archivo .env a control de versiones

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Base de Datos PostgreSQL ─────────────────────────────────────────────────
# Formato: postgres://usuario:contraseña@host:puerto/base_datos
# Reemplaza los valores con tu configuración de PostgreSQL
DB_URL=postgres://postgres:tu_contraseña@localhost:5432/farmatica

# ─── Autenticación JWT (para futuras implementaciones) ───────────────────────
# Usa un secreto fuerte y aleatorio en producción (ej: openssl rand -hex 64)
JWT_SECRET=cambia_esto_por_un_secreto_fuerte_y_aleatorio
JWT_EXPIRES_IN=7d

# ─── Supabase ─────────────────────────────────────────────────────────────────
# URL del proyecto Supabase (Settings > API > Project URL)
PROJECT_URL=https://tu-project-id.supabase.co

# Clave anon (publica) del proyecto (Settings > API > anon public)
SUPABASE_KEY=tu_supabase_anon_key

# Clave service_role (privada, NUNCA expongas en el cliente)
# Usada para llamar Edge Functions con privilegios elevados
# Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# URL base de las Edge Functions del proyecto
# Formato: https://<project-id>.supabase.co/functions/v1
SUPABASE_FUNCTIONS_URL=https://tu-project-id.supabase.co/functions/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origenes permitidos separados por coma
CROSS_ORIGIN=http://localhost:8081

