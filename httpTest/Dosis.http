@baseUrl = http://localhost:3000/api/v0
@accessToken = PEGA_AQUI_EL_ACCESS_TOKEN

### CREATE nueva Dosis
POST {{baseUrl}}/dosis
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "id_receta": 1,
    "id_medicamento": 1,
    "cantidad": 2,
    "instrucciones": "Tomar 1 tableta cada 12 horas despues de alimentos"
}

### READ una Dosis
GET {{baseUrl}}/dosis/1
Authorization: Bearer {{accessToken}}

### READ todas las Dosis
GET {{baseUrl}}/dosis/all
Authorization: Bearer {{accessToken}}

### UPDATE una Dosis
PUT {{baseUrl}}/dosis/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "id_receta": 1,
    "id_medicamento": 1,
    "cantidad": 3,
    "instrucciones": "Tomar 1 tableta cada 8 horas durante 5 dias"
}

### DELETE una Dosis
DELETE {{baseUrl}}/dosis/1
Authorization: Bearer {{accessToken}}
