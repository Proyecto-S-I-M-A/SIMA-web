@baseUrl = http://localhost:3000/api/v0
@accessToken = PEGA_AQUI_EL_ACCESS_TOKEN

### CREATE nuevo Acceso
POST {{baseUrl}}/accesos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "usuario": "ruben123",
    "tipo": "admin",
    "ultimo_acceso": "2026-04-16T12:00:00Z",
    "activo": true
}

### READ un Acceso
GET {{baseUrl}}/accesos/1
Authorization: Bearer {{accessToken}}

### READ todos los Accesos
GET {{baseUrl}}/accesos/all
Authorization: Bearer {{accessToken}}

### UPDATE un Acceso
PUT {{baseUrl}}/accesos/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "usuario": "ruben123",
    "tipo": "doctor",
    "ultimo_acceso": "2026-04-16T13:00:00Z",
    "activo": true
}

### DELETE un Acceso
DELETE {{baseUrl}}/accesos/1
Authorization: Bearer {{accessToken}}